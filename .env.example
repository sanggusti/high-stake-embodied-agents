# --- Inference providers (OpenAI-compatible) ---
# Baseten Model APIs: https://inference.baseten.co/v1
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Modal-hosted vLLM server (see infra/modal/vllm_server.py); set after `modal deploy`
MODAL_API_KEY=
MODAL_BASE_URL=

# --- Simulation backend: mock (only backend; sim tracks stayed in the bench) ---
HSEA_SIM_BACKEND=mock
# Comma-separated scenario names, or "all"
HSEA_SCENARIOS=all

# --- Run tracking ---
HSEA_RUNS_DIR=runs

# --- Edge perception budgets ---
HSEA_EDGE_REPORT_INTERVAL_STEPS=5
HSEA_EDGE_MAX_SNAPSHOTS_PER_EPISODE=8
# Edge backend: stub (rule-based) | sam (SAM 3.1 seg-maps + route tool)
HSEA_EDGE_PERCEPTION=stub

# --- Edge VLM (live detector baseline; stub-completer in tests) ---
HSEA_VLM_BASE_URL=
HSEA_VLM_API_KEY=
HSEA_VLM_MODEL=

# --- SAM 3.1 seg-maps (route mapping; native frames only, stub in tests) ---
HSEA_SAM_BASE_URL=https://api.meta.ai/v1
HSEA_SAM_API_KEY=
# META_AI_API_KEY is used when HSEA_SAM_API_KEY is empty (shared Meta key).
HSEA_SAM_MODEL=sam-3.1
# Cap on SAM scans per episode (~6 concept requests each); stale reuse after.
HSEA_SAM_MAX_SCANS_PER_EPISODE=3

# --- Flywheel (Phase D) ---
# HSEA_VISION=text forces text-only tool results (text teachers navigate on
# edge reports; multimodal models omit this for text+image results).
# HSEA_WATCH_DIR= runs/flytrain-v1/trajectories
# HSEA_WATCH=off disables L2 recording.
